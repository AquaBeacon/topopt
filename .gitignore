# NOTE: osmo_tripod/out/ is deliberately NOT ignored.
# Those files are the evidence for the numbers quoted in osmo_tripod.md and
# docs/, and tests/test_regression_osmo.py reads them as the regression
# baseline (spec 21 Phase 0). Deleting or ignoring them turns documented
# measurements back into unsupported claims -- see osmo_tripod/out/archive/README.md.

# Scratch study variants used to compare resolutions side by side.
# The settings that won get folded back into the model's own study file.
_*_study.json

# CalculiX / Gmsh working files (tens of MB per run). The evidence that is
# kept is ccx_summary.json, the .log, the deck (.inp) and the .dat totals;
# the mesh and the .frd are regenerated by `topopt ccx`.
*.frd
*.12d
*.cvg
*.sta
*_mesh.inp
*_shell.stl
*_buckle_*.inp
*_freq_*.inp
osmo_tripod/out/ccx_2mm/*.inp

# Slicer working files. The evidence that is kept is slice.json (every number
# quoted from a slice), the three flattened presets that produced it, and the
# .3mf; the plate G-code is 1-6 MB per run and `topopt slice` regenerates it
# from exactly those files.
plate_*.gcode

